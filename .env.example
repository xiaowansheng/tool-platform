# Tool Platform does not require environment variables for local development by default.
# Add optional public or service-specific variables here when a future feature needs them.
# Never commit real secrets to .env.example.

# Public canonical site URL used by sitemap and SEO metadata.
NEXT_PUBLIC_SITE_URL=https://tool-platform.local

# Target email address for user feedback
NEXT_PUBLIC_FEEDBACK_EMAIL=xiaowansheng@foxmail.com

# GitHub repository URL for the open-source link in sidebar.
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/xiaowansheng/tool-platform

# Optional writable data directory for the local SQLite stats database.
TOOL_PLATFORM_DATA_DIR=./data
